#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK="${FIRST_TOUCH_WORK:-$(mktemp -d /tmp/forgeops-first-touch-ai.XXXXXX)}"

cat <<'INTRO'
ForgeOps with AI/MCP

Give AI the ability to operate -- not unrestricted authority over the environment.

This repeats the ACME connector journey with forge-mcp as the requester adapter.
The AI/MCP caller receives a workspace Action credential, not the customer
credential, approval authority, SSH, VPN, or direct target access.
INTRO

FIRST_TOUCH_BIN_DIR="$HERE/bin" \
FIRST_TOUCH_METADATA="$HERE/metadata.env" \
FIRST_TOUCH_WORK="$WORK" \
FIRST_TOUCH_COMMANDS_BEFORE_READY=1 \
FIRST_TOUCH_INCLUDE_MCP=1 \
AUTO_DECIDE=1 \
bash "$HERE/scripts/first-touch-local.sh"

echo
echo "AI/MCP proof is in: $WORK/first-touch-ai-mcp.md"
echo "Evidence and friction measures are in: $WORK"
